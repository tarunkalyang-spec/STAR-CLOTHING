<title>MAISON — Clothing Store</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Josefin+Sans:wght@200;300;400&display=swap" rel="stylesheet"/>
<style>
/* ─── RESET & VARIABLES ─── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
  --cream:   #f5f0eb;
  --dark:    #1a1a18;
  --gold:    #b8976a;
  --gold2:   #d4b896;
  --warm:    #e8ddd4;
  --text:    #3d3a36;
  --muted:   #8a8580;
  --shadow:  0 8px 40px rgba(26,26,24,.12);
  --font-head: 'Cormorant Garamond', serif;
  --font-body: 'Josefin Sans', sans-serif;
  --ease:    cubic-bezier(.23,1,.32,1);
}

html { scroll-behavior:smooth; }
body {
  font-family: var(--font-body);
  background: var(--cream);
  color: var(--text);
  overflow-x: hidden;
  min-height:100vh;
}

/* ─── PAGE SECTIONS (SPA routing) ─── */
.page { display:none; min-height:100vh; animation: fadeIn .5s var(--ease); }
.page.active { display:block; }
@keyframes fadeIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

/* ─── NAVIGATION ─── */
nav {
  position:fixed; top:0; left:0; width:100%; z-index:100;
  display:flex; align-items:center; justify-content:space-between;
  padding:1.4rem 3rem;
  background: rgba(245,240,235,.88);
  backdrop-filter: blur(14px);
  border-bottom:1px solid rgba(184,151,106,.18);
  transition: padding .4s var(--ease), box-shadow .4s;
}
nav.scrolled { padding:.9rem 3rem; box-shadow: var(--shadow); }

.nav-logo {
  font-family: var(--font-head);
  font-size:1.7rem; font-weight:300; letter-spacing:.35em;
  color:var(--dark); text-decoration:none; cursor:pointer;
}
.nav-links { display:flex; gap:2.2rem; list-style:none; }
.nav-links a {
  text-decoration:none; color:var(--text);
  font-size:.78rem; letter-spacing:.2em; text-transform:uppercase;
  font-weight:300; position:relative; padding-bottom:.35rem;
  transition:color .3s;
}
.nav-links a::after {
  content:''; position:absolute; bottom:0; left:0;
  width:0; height:1px; background:var(--gold);
  transition:width .4s var(--ease);
}
.nav-links a:hover::after,
.nav-links a.active::after { width:100%; }
.nav-links a.active { color:var(--gold); }

.cart-btn {
  position:relative; background:none; border:none; cursor:pointer;
  font-size:1.3rem; color:var(--dark); padding:.3rem .5rem;
  transition:transform .2s;
}
.cart-btn:hover { transform:scale(1.1); }
.cart-count {
  position:absolute; top:-4px; right:-6px;
  background:var(--gold); color:#fff; font-size:.6rem;
  width:16px; height:16px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-weight:400; letter-spacing:0;
}

/* ─── HERO (HOME) ─── */
.hero {
  height:100vh; display:flex; align-items:center; justify-content:center;
  position:relative; overflow:hidden;
  background:linear-gradient(145deg, var(--dark) 0%, #2e2c28 50%, #3a3732 100%);
}
.hero-bg-pattern {
  position:absolute; inset:0; opacity:.06;
  background: repeating-linear-gradient(45deg, transparent, transparent 40px, #fff 40px, #fff 41px);
}
.hero-content { position:relative; z-index:2; text-align:center; }
.hero h1 {
  font-family: var(--font-head); font-weight:300;
  font-size: clamp(3.5rem, 10vw, 8rem);
  color:#fff; letter-spacing:.2em; line-height:1.1;
  animation: heroSlide .9s var(--ease) .2s both;
}
@keyframes heroSlide { from { opacity:0; transform:translateY(40px); } to { opacity:1; transform:translateY(0); } }
.hero-sub {
  color:var(--gold2); font-size:.82rem; letter-spacing:.4em;
  text-transform:uppercase; margin-top:1.2rem; font-weight:200;
  animation: heroSlide .9s var(--ease) .45s both;
}
.hero-cta {
  display:inline-block; margin-top:2.8rem;
  padding:.95rem 2.8rem; border:1px solid var(--gold);
  color:var(--gold2); text-decoration:none;
  font-size:.75rem; letter-spacing:.3em; text-transform:uppercase;
  transition: background .35s, color .35s, transform .2s;
  cursor:pointer; background:transparent;
  animation: heroSlide .9s var(--ease) .65s both;
}
.hero-cta:hover { background:var(--gold); color:#fff; transform:scale(1.03); }

/* ─── CATEGORIES STRIP ─── */
.categories {
  display:flex; gap:1.5rem; justify-content:center;
  flex-wrap:wrap; padding:3.5rem 2rem;
}
.cat-card {
  width:240px; height:300px; border-radius:6px; overflow:hidden;
  position:relative; cursor:pointer;
  box-shadow: var(--shadow);
  transition:transform .4s var(--ease), box-shadow .4s;
}
.cat-card:hover { transform:translateY(-6px); box-shadow: 0 16px 50px rgba(0,0,0,.15); }
.cat-card-img {
  width:100%; height:100%; object-fit:cover;
  transition:transform .6s var(--ease);
}
.cat-card:hover .cat-card-img { transform:scale(1.06); }
.cat-card-overlay {
  position:absolute; inset:0;
  background:linear-gradient(to top, rgba(26,26,24,.7) 0%, transparent 60%);
  display:flex; align-items:flex-end; padding:1.8rem;
}
.cat-card-overlay span {
  color:#fff; font-family:var(--font-head); font-size:1.5rem;
  font-weight:300; letter-spacing:.15em;
}

/* ─── SECTION TITLES ─── */
.sec-title {
  text-align:center; padding:3rem 1rem 1.5rem;
  font-family:var(--font-head); font-size:2.2rem; font-weight:300;
  letter-spacing:.18em; color:var(--dark);
}
.sec-line {
  width:48px; height:1px; background:var(--gold);
  margin:0 auto 2rem; 
}

/* ─── PRODUCT GRID ─── */
.product-filters {
  display:flex; justify-content:center; gap:1.2rem;
  flex-wrap:wrap; padding:0 1rem 2rem;
}
.filter-btn {
  padding:.5rem 1.4rem; border:1px solid var(--muted);
  background:transparent; color:var(--muted);
  font-family:var(--font-body); font-size:.72rem;
  letter-spacing:.2em; text-transform:uppercase;
  cursor:pointer; border-radius:30px;
  transition:all .3s;
}
.filter-btn:hover, .filter-btn.active {
  border-color:var(--gold); background:var(--gold); color:#fff;
}

.product-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(240px,1fr));
  gap:2rem; padding:0 3rem 4rem; max-width:1200px; margin:0 auto;
}
.product-card {
  background:#fff; border-radius:6px; overflow:hidden;
  box-shadow:0 2px 20px rgba(0,0,0,.06);
  transition:transform .4s var(--ease), box-shadow .4s;
  cursor:pointer;
}
.product-card:hover { transform:translateY(-5px); box-shadow:var(--shadow); }

.product-img-wrap {
  position:relative; overflow:hidden;
  background:var(--warm); aspect-ratio:3/4;
  display:flex; align-items:center; justify-content:center;
}
.product-emoji { font-size:5rem; transition:transform .4s var(--ease); }
.product-card:hover .product-emoji { transform:scale(1.08); }
.product-tag {
  position:absolute; top:.8rem; left:.8rem;
  background:var(--dark); color:#fff;
  font-size:.62rem; letter-spacing:.18em; text-transform:uppercase;
  padding:.3rem .7rem; border-radius:3px;
}

.product-info { padding:1.2rem 1rem; }
.product-info h3 {
  font-family:var(--font-head); font-weight:400; font-size:1.15rem;
  letter-spacing:.08em; margin-bottom:.3rem; color:var(--dark);
}
.product-info .price {
  color:var(--gold); font-size:.82rem; font-weight:300; letter-spacing:.12em;
}
.product-info .price-old {
  text-decoration:line-through; color:var(--muted);
  font-size:.72rem; margin-left:.5rem;
}
.add-to-cart-btn {
  display:block; width:100%; padding:.7rem;
  border:1px solid var(--dark); background:transparent;
  color:var(--dark); font-family:var(--font-body);
  font-size:.68rem; letter-spacing:.2em; text-transform:uppercase;
  cursor:pointer; transition:all .3s; margin-top:.6rem;
}
.add-to-cart-btn:hover { background:var(--dark); color:#fff; }

/* ─── ABOUT PAGE ─── */
.about-hero {
  height:45vh; display:flex; align-items:center; justify-content:center;
  background:var(--dark); position:relative; overflow:hidden;
}
.about-hero::before {
  content:''; position:absolute; inset:0; opacity:.07;
  background:repeating-linear-gradient(0deg, transparent, transparent 30px, #fff 30px, #fff 31px);
}
.about-hero h1 {
  font-family:var(--font-head); color:#fff; font-weight:300;
  font-size:clamp(2.5rem,7vw,5rem); letter-spacing:.25em;
  position:relative; z-index:1;
}

.about-content {
  max-width:800px; margin:0 auto; padding:4rem 2rem;
  text-align:center;
}
.about-content p {
  font-size:.88rem; line-height:1.9; color:var(--text);
  font-weight:200; margin-bottom:1.5rem; letter-spacing:.04em;
}
.about-values {
  display:flex; gap:2.5rem; justify-content:center;
  flex-wrap:wrap; margin-top:3rem;
}
.value-card {
  width:200px; text-align:center; padding:2rem 1rem;
  border-top:1px solid var(--gold);
}
.value-card .icon { font-size:2rem; margin-bottom:.8rem; }
.value-card h4 {
  font-family:var(--font-head); font-size:1.1rem; font-weight:400;
  letter-spacing:.12em; margin-bottom:.5rem; color:var(--dark);
}
.value-card p { font-size:.76rem; color:var(--muted); line-height:1.7; }

/* ─── CONTACT PAGE ─── */
.contact-wrap {
  max-width:700px; margin:0 auto; padding:4rem 2rem 5rem;
}
.contact-wrap input,
.contact-wrap textarea,
.contact-wrap select {
  width:100%; padding:.95rem 0; border:none; border-bottom:1px solid #ccc;
  background:transparent; font-family:var(--font-body);
  font-size:.82rem; color:var(--text); letter-spacing:.06em;
  outline:none; transition:border-color .3s; margin-bottom:.6rem;
}
.contact-wrap input:focus,
.contact-wrap textarea:focus { border-color:var(--gold); }
.contact-wrap textarea { resize:vertical; min-height:100px; margin-top:.4rem; }
.contact-wrap label {
  display:block; font-size:.68rem; letter-spacing:.22em;
  text-transform:uppercase; color:var(--muted); margin-bottom:.3rem; margin-top:1rem;
}
.contact-submit {
  display:block; width:100%; padding:1rem;
  background:var(--dark); color:#fff; border:none;
  font-family:var(--font-body); font-size:.75rem;
  letter-spacing:.28rem; text-transform:uppercase;
  cursor:pointer; margin-top:2rem; border-radius:4px;
  transition:background .3s, transform .15s;
}
.contact-submit:hover { background:#2e2c28; transform:scale(.985); }

/* ─── CART SIDEBAR ─── */
.cart-overlay {
  position:fixed; inset:0; background:rgba(26,26,24,.45);
  z-index:200; opacity:0; pointer-events:none;
  transition:opacity .35s;
}
.cart-overlay.open { opacity:1; pointer-events:all; }
.cart-sidebar {
  position:fixed; top:0; right:-420px; width:400px; max-width:92vw;
  height:100%; background:#fff; z-index:201;
  box-shadow:-10px 0 40px rgba(0,0,0,.15);
  transition:right .4s var(--ease);
  display:flex; flex-direction:column;
}
.cart-sidebar.open { right:0; }
.cart-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:1.6rem 1.8rem; border-bottom:1px solid #eee;
}
.cart-header h2 {
  font-family:var(--font-head); font-weight:300; font-size:1.4rem;
  letter-spacing:.15em;
}
.cart-close {
  background:none; border:none; font-size:1.5rem;
  cursor:pointer; color:var(--muted); transition:color .2s;
}
.cart-close:hover { color:var(--dark); }
.cart-items { flex:1; overflow-y:auto; padding:1.5rem 1.8rem; }
.cart-item {
  display:flex; align-items:center; gap:1rem;
  padding:1rem 0; border-bottom:1px solid #f0ece8;
}
.cart-item-emoji { font-size:2rem; }
.cart-item-info { flex:1; }
.cart-item-info h4 { font-family:var(--font-head); font-size:1rem; font-weight:400; }
.cart-item-info p { font-size:.74rem; color:var(--muted); margin-top:.15rem; }
.cart-item-remove {
  background:none; border:none; color:var(--muted);
  font-size:1.1rem; cursor:pointer; transition:color .2s;
}
.cart-item-remove:hover { color:#c0392b; }
.cart-footer { padding:1.5rem 1.8rem; border-top:1px solid #eee; }
.cart-total {
  display:flex; justify-content:space-between; align-items:center;
  font-family:var(--font-head); font-size:1.15rem; margin-bottom:1.2rem;
}
.cart-total span:last-child { color:var(--gold); }
.checkout-btn {
  display:block; width:100%; padding:.95rem;
  background:var(--dark); color:#fff; border:none;
  font-family:var(--font-body); font-size:.74rem;
  letter-spacing:.25rem; text-transform:uppercase;
  cursor:pointer; border-radius:4px; transition:background .3s;
}
.checkout-btn:hover { background:#2e2c28; }
.cart-empty { text-align:center; padding:3rem 0; color:var(--muted); font-size:.82rem; letter-spacing:.08em; }

/* ─── NEWSLETTER STRIP ─── */
.newsletter {
  background:var(--dark); padding:3.5rem 2rem; text-align:center;
}
.newsletter h3 {
  font-family:var(--font-head); color:#fff; font-weight:300;
  font-size:1.6rem; letter-spacing:.18em; margin-bottom:.6rem;
}
.newsletter p { color:var(--muted); font-size:.76rem; letter-spacing:.08em; margin-bottom:1.6rem; }
.newsletter-form { display:flex; max-width:440px; margin:0 auto; gap:.6rem; }
.newsletter-form input {
  flex:1; padding:.8rem 1.2rem; border:1px solid rgba(255,255,255,.15);
  background:transparent; color:#fff; border-radius:4px;
  font-family:var(--font-body); font-size:.76rem; letter-spacing:.1em; outline:none;
}
.newsletter-form input::placeholder { color:var(--muted); }
.newsletter-form button {
  padding:.8rem 1.6rem; background:var(--gold); color:#fff; border:none;
  font-family:var(--font-body); font-size:.7rem; letter-spacing:.2em;
  text-transform:uppercase; border-radius:4px; cursor:pointer;
  transition:background .3s;
}
.newsletter-form button:hover { background:var(--gold2); }

/* ─── FOOTER ─── */
footer {
  background:#16161 ; padding:2.5rem 2rem 1.8rem; text-align:center;
  border-top:1px solid rgba(184,151,106,.15);
}
footer p { font-size:.68rem; color:var(--muted); letter-spacing:.12em; }
footer .footer-links { margin-bottom:.8rem; }
footer .footer-links a {
  color:var(--muted); text-decoration:none; margin:0 .7rem;
  font-size:.68rem; letter-spacing:.12em; transition:color .3s;
}
footer .footer-links a:hover { color:var(--gold); }

/* ─── TOAST ─── */
.toast {
  position:fixed; bottom:2rem; left:50%; transform:translateX(-50%) translateY(100px);
  background:var(--dark); color:#fff; padding:.85rem 2rem;
  border-radius:6px; font-size:.78rem; letter-spacing:.1em;
  z-index:300; transition:transform .4s var(--ease);
  box-shadow:0 6px 24px rgba(0,0,0,.25);
}
.toast.show { transform:translateX(-50%) translateY(0); }

/* ─── RESPONSIVE ─── */
@media(max-width:600px){
  nav { padding:1rem 1.2rem; }
  .nav-links { gap:1rem; }
  .nav-links a { font-size:.68rem; }
  .product-grid { padding:0 1.2rem; grid-template-columns:repeat(auto-fill, minmax(150px,1fr)); gap:1rem; }
  .cat-card { width:calc(50% - .75rem); height:200px; }
  .categories { gap:.75rem; padding:2rem 1rem; }
  .about-values { gap:1rem; }
  .value-card { width:calc(50% - .5rem); }
}
</style>
</head>
