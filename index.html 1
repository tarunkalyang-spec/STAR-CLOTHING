      <div class="product-img-wrap cat-card-img" style="background:linear-gradient(135deg,#d9cdc0,#c4b5a2); height:100%; display:flex; align-items:center; justify-content:center; font-size:6rem;">👗</div>
      <div class="cat-card-overlay"><span>Women</span></div>
    </div>
    <div class="cat-card" onclick="filterAndGoShop('Men')">
      <div class="product-img-wrap cat-card-img" style="background:linear-gradient(135deg,#c8bfb5,#b3a899); height:100%; display:flex; align-items:center; justify-content:center; font-size:6rem;">🧥</div>
      <div class="cat-card-overlay"><span>Men</span></div>
    </div>
    <div class="cat-card" onclick="filterAndGoShop('Accessories')">
      <div class="product-img-wrap cat-card-img" style="background:linear-gradient(135deg,#dfd5c8,#cec4b6); height:100%; display:flex; align-items:center; justify-content:center; font-size:6rem;">👜</div>
      <div class="cat-card-overlay"><span>Accessories</span></div>
    </div>
    <div class="cat-card" onclick="filterAndGoShop('Footwear')">
      <div class="product-img-wrap cat-card-img" style="background:linear-gradient(135deg,#cec3b6,#bfb4a7); height:100%; display:flex; align-items:center; justify-content:center; font-size:6rem;">👠</div>
      <div class="cat-card-overlay"><span>Footwear</span></div>
    </div>
